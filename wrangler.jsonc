{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intellectualtakeout",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The worker fronts every request: it counts article views, serves
    // /feed/, /og/*, /audio/*, /podcast.xml, media, and the APIs, and passes
    // everything else through to static assets.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://intellectualtakeout.org",
    // Remove/empty this at DNS cutover (would proxy to itself); until then it
    // lazily backfills R2 from the live WordPress site.
    "LEGACY_MEDIA_ORIGIN": "https://intellectualtakeout.org",
    "EMAIL_PROVIDER": "log",
    "EMAIL_FROM": "Intellectual Takeout <newsletter@intellectualtakeout.org>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intellectualtakeout-newsletter",
      "database_id": "b376f750-b544-4a2a-aa16-5d66ceb62bca"
    }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "intellectualtakeout-media"
    }
  ],
  "triggers": {
    // 12:00 UTC: daily digest email; every 30 min: search-index freshness check
    "crons": ["0 12 * * *", "0 13 * * 0", "*/30 * * * *"]
  }
}
