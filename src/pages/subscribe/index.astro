---
import Base from '../../layouts/Base.astro';

const CATEGORY_OPTIONS = ['Culture', 'Education', 'Family', 'Health', 'Philosophy', 'Politics', 'Economics', 'History'];
---

<Base title="Subscribe" description="Sign up for the Intellectual Takeout newsletter — daily digest or weekly best-of, tailored to the topics you care about.">
  <div class="container">
    <main style="max-width:640px;margin:0 auto;padding:50px 0;">
      <h1 class="box_header">Stay in the Know</h1>
      <p style="font-size:20px;line-height:1.5;">
        Intellectually engaging content, straight to your inbox. Choose how often you hear from
        us and which topics you care about — or leave the topics blank to get everything.
      </p>

      <form id="subscribe-form">
        <div class="freq_row">
          <label><input type="radio" name="frequency" value="daily" checked /> Daily Digest</label>
          <label><input type="radio" name="frequency" value="weekly" /> Weekly Best-of only</label>
        </div>
        <div class="prefs_grid">
          {CATEGORY_OPTIONS.map((c) => (
            <label><input type="checkbox" name="categories" value={c} /> {c}</label>
          ))}
        </div>
        <div class="newsletter_form">
          <input type="email" name="email" placeholder="Your email address" required />
          <button type="submit">Subscribe Now</button>
        </div>
        <p class="form_note" data-note aria-live="polite"></p>
      </form>

      <p style="font-family:var(--sans);font-size:12px;color:var(--meta-gray);margin-top:26px;">
        Prefer a feed? Subscribe by <a href="/feed/">RSS</a> or listen via the
        <a href="/podcast.xml">audio edition podcast</a>.
      </p>
    </main>
  </div>
</Base>

<script>
  const form = document.getElementById('subscribe-form') as HTMLFormElement;
  const note = form.querySelector('[data-note]') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    note.textContent = 'Subscribing…';
    try {
      const r = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email: fd.get('email'),
          frequency: fd.get('frequency'),
          categories: fd.getAll('categories'),
        }),
      });
      const data = await r.json();
      note.textContent = data.message ?? (r.ok ? 'Check your inbox to confirm.' : 'Something went wrong — please try again.');
      if (r.ok) (form.querySelector('[name=email]') as HTMLInputElement).value = '';
    } catch {
      note.textContent = 'Something went wrong — please try again.';
    }
  });
</script>
