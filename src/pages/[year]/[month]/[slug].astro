---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Sidebar from '../../../components/Sidebar.astro';
import PostCard from '../../../components/PostCard.astro';
import { allArticles, articlePath, formatDate, slugify } from '../../../lib/content';
import { SITE } from '../../../lib/site';

export async function getStaticPaths() {
  const articles = await allArticles();
  return articles.map((article) => {
    const [year, month, ...rest] = article.id.replace(/\.md$/, '').split('/');
    return { params: { year, month, slug: rest.join('/') }, props: { article } };
  });
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;
const canonical = new URL(articlePath(article), SITE.url).href;

const articles = await allArticles();
const related = articles
  .filter((a) => a.id !== article.id && a.data.categorySlugs.some((c) => d.categorySlugs.includes(c)))
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { '@type': 'Person', name: d.author, url: new URL(`/author/${d.authorSlug}/`, SITE.url).href },
  publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: new URL(SITE.logo, SITE.url).href } },
  mainEntityOfPage: canonical,
  ...(d.heroImage ? { image: new URL(d.heroImage, SITE.url).href } : {}),
};

const initials = d.author.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

<Base
  title={d.title}
  description={d.description}
  canonical={canonical}
  ogType="article"
  ogImage={`/og${articlePath(article)}card.png`}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={d.pubDate.toISOString()} />
    {d.updatedDate && <meta property="article:modified_time" content={d.updatedDate.toISOString()} />}
    <meta property="article:author" content={d.author} />
    {d.categories.map((c) => <meta property="article:section" content={c} />)}
    {d.tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>

  <div class="container">
    <div class="columns_layout">
      <main class="article_main">
        <h1>{d.title}</h1>
        <div class="article_meta">
          In{' '}
          {d.categories.map((c, i) => (
            <>
              <a href={`/category/${slugify(c)}/`}>{c}</a>{i < d.categories.length - 1 && ', '}
            </>
          ))}
          {' · '}{formatDate(d.pubDate)}{' · '}
          <a href={`/author/${d.authorSlug}/`}>{d.author}</a>
        </div>

        {d.heroImage && (
          <div class="article_hero">
            <img src={d.heroImage} alt={d.title} width="720" />
          </div>
        )}

        <div class="audio_box" data-audio-box>
          <span class="label">Listen to this article</span>
          <audio controls preload="none" data-audio-player></audio>
        </div>

        <div class="author_box">
          <div class="avatar" aria-hidden="true">{initials}</div>
          <div class="name">{d.author}</div>
          <div class="role">Contributor</div>
          <a class="profile" href={`/author/${d.authorSlug}/`}>Profile</a>
        </div>

        <div class="article_body">
          <Content />
        </div>

        <div class="share_bar" data-share-bar data-title={d.title} data-author={d.author}>
          <span class="label">Share:</span>
          <a data-share="x" href="#" target="_blank" rel="noopener">X</a>
          <a data-share="facebook" href="#" target="_blank" rel="noopener">Facebook</a>
          <a data-share="email" href="#">Email</a>
          <button data-share="copy">Copy Link</button>
        </div>

        {d.tags.length > 0 && (
          <div class="article_tags">
            {d.tags.map((t) => <a href={`/tag/${slugify(t)}/`}>{t}</a>)}
          </div>
        )}

        <p class="license_note">
          Except where otherwise noted, the content on this site is licensed under a{' '}
          <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">
            Creative Commons Attribution-ShareAlike 4.0 International License
          </a>.
        </p>

        {related.length > 0 && (
          <section>
            <h2 class="box_header">Read More</h2>
            <div class="posts_grid three" data-related-grid>
              {related.map((a) => <PostCard article={a} showByline={false} />)}
            </div>
          </section>
        )}
      </main>
      <Sidebar articles={articles} />
    </div>
  </div>

  <button class="quote_pop" data-quote-pop>Share this quote</button>
</Base>

<script>
  const path = location.pathname;

  // ---- share bar
  const bar = document.querySelector<HTMLElement>('[data-share-bar]');
  if (bar) {
    const u = encodeURIComponent(location.href.split('#')[0].split('?')[0]);
    const t = encodeURIComponent(bar.dataset.title ?? document.title);
    (bar.querySelector('[data-share=x]') as HTMLAnchorElement).href = `https://twitter.com/intent/tweet?url=${u}&text=${t}`;
    (bar.querySelector('[data-share=facebook]') as HTMLAnchorElement).href = `https://www.facebook.com/sharer/sharer.php?u=${u}`;
    (bar.querySelector('[data-share=email]') as HTMLAnchorElement).href = `mailto:?subject=${t}&body=${u}`;
    bar.querySelector('[data-share=copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      await navigator.clipboard.writeText(location.href.split('#')[0]);
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = 'Copy Link'), 1500);
    });
  }

  // ---- audio narration (shown only when available)
  fetch(`/api/audio/status?path=${encodeURIComponent(path)}`)
    .then((r) => (r.ok ? r.json() : null))
    .then((data) => {
      if (!data?.available) return;
      const box = document.querySelector<HTMLElement>('[data-audio-box]')!;
      const player = box.querySelector<HTMLAudioElement>('[data-audio-player]')!;
      player.src = `/audio${path.replace(/\/$/, '')}.mp3`;
      box.classList.add('available');
    })
    .catch(() => {});

  // ---- semantic related reading (upgrades the static Read More grid)
  const grid = document.querySelector<HTMLElement>('[data-related-grid]');
  if (grid) {
    fetch(`/api/related?url=${encodeURIComponent(path)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data?.results?.length) return;
        grid.innerHTML = data.results
          .slice(0, 3)
          .map(
            (a: any) => `
          <article class="post_card">
            <h2><a href="${a.url}">${a.title}</a></h2>
            <span class="date">${new Date(a.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            <div class="byline">By ${a.author}</div>
          </article>`
          )
          .join('');
      })
      .catch(() => {});
  }

  // ---- quote sharing
  const pop = document.querySelector<HTMLButtonElement>('[data-quote-pop]')!;
  const body = document.querySelector('.article_body');
  document.addEventListener('selectionchange', () => {
    const sel = document.getSelection();
    const text = sel?.toString().trim() ?? '';
    if (!text || text.length < 20 || text.length > 420 || !body || !sel || !body.contains(sel.anchorNode)) {
      pop.style.display = 'none';
      return;
    }
    const rect = sel.getRangeAt(0).getBoundingClientRect();
    pop.style.display = 'block';
    pop.style.top = `${rect.top + window.scrollY - 40}px`;
    pop.style.left = `${rect.left + window.scrollX + rect.width / 2 - 60}px`;
  });
  pop.addEventListener('mousedown', (e) => {
    e.preventDefault();
    const text = document.getSelection()?.toString().trim() ?? '';
    if (!text) return;
    const params = new URLSearchParams({
      text,
      title: (bar?.dataset.title ?? '').slice(0, 140),
      author: bar?.dataset.author ?? '',
      article: path,
    });
    window.open(`/quote/?${params}`, '_blank');
  });
</script>
