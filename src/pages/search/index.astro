---
import Base from '../../layouts/Base.astro';
---

<Base title="Search" noindex>
  <div class="container">
    <main style="max-width:760px;margin:0 auto;padding:40px 0 60px;">
      <h1 class="box_header">Search Intellectual Takeout</h1>
      <form id="search-form" role="search" style="display:flex;gap:8px;">
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder="Search 10,000+ articles…"
          autocomplete="off"
          style="flex:1;padding:13px 14px;border:1px solid #d5d5d5;font-family:var(--sans);font-size:14px;"
        />
        <button
          type="submit"
          style="background:#2e3e42;color:#fff;border:0;padding:0 24px;font-family:var(--sans);text-transform:uppercase;font-size:11px;letter-spacing:1px;cursor:pointer;"
        >
          Search
        </button>
      </form>
      <p id="search-status" class="form_note" aria-live="polite"></p>
      <div id="search-results"></div>
      <nav id="search-pagination" class="pagination" style="justify-content:center;"></nav>
    </main>
  </div>
</Base>

<style is:global>
  .search_hit { border-bottom: 1px solid #ececec; padding: 20px 0; }
  .search_hit h2 { font-family: var(--serif); font-size: 24px; font-weight: 700; line-height: 1.15; margin-bottom: 6px; }
  .search_hit h2 a { color: var(--ink); }
  .search_hit h2 a:hover { color: var(--accent); text-decoration: none; }
  .search_hit .meta { font-family: var(--sans); font-size: 11px; color: var(--meta-gray); margin-bottom: 8px; }
  .search_hit .meta a { color: var(--accent); font-weight: 700; }
  .search_hit .snippet { font-size: 17px; line-height: 1.45; color: #222; }
  .search_hit .snippet mark { background: #d8ecec; color: inherit; padding: 0 2px; }
  .search_hit .thumbline { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: start; }
  .search_hit .thumbline .thumb { aspect-ratio: 3/2; overflow: hidden; background: #eee; }
  .search_hit .thumbline .thumb img { width: 100%; height: 100%; object-fit: cover; }
</style>

<script>
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const status = document.getElementById('search-status') as HTMLElement;
  const resultsEl = document.getElementById('search-results') as HTMLElement;
  const pagerEl = document.getElementById('search-pagination') as HTMLElement;

  let controller: AbortController | null = null;
  let debounce: number | undefined;

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
  // Snippets arrive as text with <mark>…</mark> from the API; escape everything
  // else so article text can't inject markup.
  function renderSnippet(s: string): string {
    return esc(s).replaceAll('&lt;mark&gt;', '<mark>').replaceAll('&lt;/mark&gt;', '</mark>');
  }
  function fmtDate(iso: string): string {
    const d = new Date(iso);
    return isNaN(d.getTime())
      ? ''
      : d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  async function runSearch(q: string, page = 1, pushState = true) {
    if (controller) controller.abort();
    if (!q.trim()) {
      resultsEl.innerHTML = '';
      pagerEl.innerHTML = '';
      status.textContent = '';
      return;
    }
    controller = new AbortController();
    status.textContent = 'Searching…';
    try {
      const r = await fetch(`/api/search?q=${encodeURIComponent(q)}&page=${page}`, { signal: controller.signal });
      const data = await r.json();
      if (pushState) {
        const u = new URL(location.href);
        u.searchParams.set('q', q);
        page > 1 ? u.searchParams.set('page', String(page)) : u.searchParams.delete('page');
        history.replaceState(null, '', u);
      }
      if (!r.ok) {
        status.textContent = 'Search is temporarily unavailable — please try again shortly.';
        return;
      }
      status.textContent = data.total
        ? `${data.total.toLocaleString()} result${data.total === 1 ? '' : 's'} for “${q}”`
        : `No results for “${q}”. Try fewer or broader words.`;
      resultsEl.innerHTML = data.results
        .map(
          (hit: any) => `
        <article class="search_hit">
          <div class="${hit.hero ? 'thumbline' : ''}">
            ${hit.hero ? `<a class="thumb" href="${esc(hit.url)}"><img src="${esc(hit.hero)}" alt="" loading="lazy"/></a>` : ''}
            <div>
              <h2><a href="${esc(hit.url)}">${esc(hit.title)}</a></h2>
              <div class="meta">${esc(hit.author)}${hit.pubDate ? ' · ' + fmtDate(hit.pubDate) : ''}${hit.categories ? ' · ' + esc(hit.categories) : ''}</div>
              <p class="snippet">${renderSnippet(hit.snippet ?? '')}</p>
            </div>
          </div>
        </article>`
        )
        .join('');
      const totalPages = Math.ceil(data.total / (data.perPage ?? 10));
      pagerEl.innerHTML = '';
      if (totalPages > 1) {
        const mk = (n: number, label: string, current = false) =>
          current
            ? `<span class="current">${label}</span>`
            : `<a href="#" data-page="${n}">${label}</a>`;
        const parts: string[] = [];
        if (page > 1) parts.push(mk(page - 1, '« Prev'));
        for (let n = Math.max(1, page - 2); n <= Math.min(totalPages, page + 2); n++) parts.push(mk(n, String(n), n === page));
        if (page < totalPages) parts.push(mk(page + 1, 'Next »'));
        pagerEl.innerHTML = parts.join('');
        pagerEl.querySelectorAll('a[data-page]').forEach((a) =>
          a.addEventListener('click', (e) => {
            e.preventDefault();
            runSearch(input.value, Number((a as HTMLElement).dataset.page));
            window.scrollTo({ top: 0 });
          })
        );
      }
    } catch (e) {
      if ((e as Error).name !== 'AbortError') status.textContent = 'Search failed — please try again.';
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    runSearch(input.value);
  });
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = window.setTimeout(() => runSearch(input.value), 350);
  });

  const params = new URLSearchParams(location.search);
  const q0 = params.get('q');
  if (q0) {
    input.value = q0;
    runSearch(q0, Number(params.get('page')) || 1, false);
  }
  input.focus();
</script>
