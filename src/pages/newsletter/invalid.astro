---
import Base from '../../layouts/Base.astro';
---

<Base title="Link Expired" noindex>
  <div class="container">
    <main style="max-width:640px;margin:0 auto;text-align:center;padding:70px 0;">
      <h1 style="font-family:var(--serif);font-size:40px;">This link is no longer valid</h1>
      <p style="font-size:20px;margin-top:14px;">
        The confirmation link may have expired. Please
        <a href="/subscribe/">sign up again</a> to receive a fresh one.
      </p>
    </main>
  </div>
</Base>
