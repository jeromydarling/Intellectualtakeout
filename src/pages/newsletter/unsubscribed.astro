---
import Base from '../../layouts/Base.astro';
---

<Base title="Unsubscribed" noindex>
  <div class="container">
    <main style="max-width:640px;margin:0 auto;text-align:center;padding:70px 0;">
      <h1 style="font-family:var(--serif);font-size:40px;">You've been unsubscribed</h1>
      <p style="font-size:20px;margin-top:14px;">
        Sorry to see you go. You can rejoin the <em>Daily Digest</em> any time from our
        <a href="/subscribe/">subscribe page</a>.
      </p>
    </main>
  </div>
</Base>
