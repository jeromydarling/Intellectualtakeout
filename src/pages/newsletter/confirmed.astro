---
import Base from '../../layouts/Base.astro';
---

<Base title="Subscription Confirmed" noindex>
  <div class="container">
    <main style="max-width:640px;margin:0 auto;text-align:center;padding:70px 0;">
      <h1 style="font-family:var(--serif);font-size:40px;">You're subscribed!</h1>
      <p style="font-size:20px;margin-top:14px;">
        Thanks for confirming — the <em>Daily Digest</em> will arrive in your inbox each day.
      </p>
      <p style="margin-top:30px;"><a href="/">Back to the homepage</a></p>
    </main>
  </div>
</Base>
