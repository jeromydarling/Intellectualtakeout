---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Pagination from '../../../components/Pagination.astro';
import { allArticles, byTag } from '../../../lib/content';
import { SITE } from '../../../lib/site';
import tags from '../../../data/tags.json';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const articles = await allArticles();
  return tags.flatMap((tag) => {
    const items = byTag(articles, tag.slug);
    if (items.length === 0) return [];
    return paginate(items, {
      params: { slug: tag.slug },
      props: { tag },
      pageSize: SITE.postsPerPage,
    });
  });
};

const { page, tag } = Astro.props as any;
const articles = await allArticles();
const title = page.currentPage > 1 ? `${tag.name} - Page ${page.currentPage}` : `Tag: ${tag.name}`;
---

<Base title={title} description={`Articles tagged "${tag.name}" at ${SITE.name}.`}>
  <div class="container">
    <div class="columns_layout">
      <main>
        <h1 class="box_header">Tag: {tag.name}</h1>
        <div class="posts_grid">
          {page.data.map((a: any) => <PostCard article={a} />)}
        </div>
        <Pagination page={page} />
      </main>
      <Sidebar articles={articles} />
    </div>
  </div>
</Base>
