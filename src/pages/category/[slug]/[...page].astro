---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Pagination from '../../../components/Pagination.astro';
import { allArticles, byCategory } from '../../../lib/content';
import { SITE } from '../../../lib/site';
import categories from '../../../data/categories.json';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const articles = await allArticles();
  return categories.flatMap((cat) => {
    const items = byCategory(articles, cat.slug);
    if (items.length === 0) return [];
    return paginate(items, {
      params: { slug: cat.slug },
      props: { cat },
      pageSize: SITE.postsPerPage,
    });
  });
};

const { page, cat } = Astro.props as any;
const articles = await allArticles();
const title = page.currentPage > 1 ? `${cat.name} - Page ${page.currentPage}` : cat.name;
---

<Base title={title} description={cat.description || `${cat.name} articles from ${SITE.name}.`}>
  <div class="container">
    <div class="columns_layout">
      <main>
        <h1 class="box_header">{cat.name}</h1>
        <div class="posts_grid">
          {page.data.map((a: any) => <PostCard article={a} />)}
        </div>
        <Pagination page={page} />
      </main>
      <Sidebar articles={articles} />
    </div>
  </div>
</Base>
