---
import PostCard from './PostCard.astro';
import type { Article } from '../lib/content';
import authors from '../data/authors.json';

interface Props { articles: Article[] }
const { articles } = Astro.props;

const latest = articles.slice(0, 3);
const history = articles.filter((a) => a.data.categorySlugs.includes('history')).slice(0, 4);
const contributors = authors
  .filter((a) => a.slug !== 'intellectual-takeout')
  .slice(0, 10);
const initials = (name: string) =>
  name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

<aside class="sidebar">
  <div class="widget" data-mostread-widget hidden>
    <h2 class="box_header">Most Read</h2>
    <div class="mostread_tabs" role="tablist">
      <button data-window="24h">Today</button>
      <button data-window="7d" class="active">This Week</button>
      <button data-window="30d">This Month</button>
    </div>
    <div data-mostread-list></div>
  </div>

  <div class="widget">
    <h2 class="box_header">Latest Posts</h2>
    {latest.map((a) => <PostCard article={a} variant="row" />)}
  </div>

  <div class="widget">
    <h2 class="box_header">Frequent Contributors</h2>
    <div class="contributors_grid">
      {contributors.map((c) => (
        <div class="contributor">
          <a href={`/author/${c.slug}/`} class="avatar" aria-hidden="true">{initials(c.name)}</a>
          <div class="name"><a href={`/author/${c.slug}/`}>{c.name}</a></div>
        </div>
      ))}
    </div>
  </div>

  {history.length > 0 && (
    <div class="widget">
      <h2 class="box_header">History</h2>
      {history.map((a) => <PostCard article={a} variant="row" />)}
      <a href="/category/history/" class="box_header" style="display:block;text-align:center;">More in History</a>
    </div>
  )}
</aside>

<script>
  const widget = document.querySelector<HTMLElement>('[data-mostread-widget]');
  if (widget) {
    const list = widget.querySelector<HTMLElement>('[data-mostread-list]')!;
    const load = async (win: string) => {
      try {
        const r = await fetch(`/api/mostread?window=${win}&limit=5`);
        if (!r.ok) return;
        const data = await r.json();
        if (!data.results?.length) return;
        list.innerHTML = data.results
          .map(
            (a: any) => `
          <article class="post_row">
            <a class="thumb" href="${a.path}">${a.hero ? `<img src="${a.hero}" alt="" loading="lazy"/>` : ''}</a>
            <div>
              <h3><a href="${a.path}">${a.title}</a></h3>
              <div class="date">${Number(a.views).toLocaleString()} reads</div>
            </div>
          </article>`
          )
          .join('');
        widget.hidden = false;
      } catch { /* stay hidden */ }
    };
    widget.querySelectorAll<HTMLButtonElement>('[data-window]').forEach((btn) =>
      btn.addEventListener('click', () => {
        widget.querySelectorAll('[data-window]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        load(btn.dataset.window!);
      })
    );
    load('7d');
  }
</script>
