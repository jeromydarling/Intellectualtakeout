---
interface Props { page: any }
const { page } = Astro.props;
const totalPages = Math.ceil(page.total / page.size);

function pageNumbers(current: number, total: number): (number | '…')[] {
  const nums = new Set<number>([1, 2, total - 1, total, current - 1, current, current + 1]);
  const list = [...nums].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
  const out: (number | '…')[] = [];
  let prev = 0;
  for (const n of list) {
    if (n - prev > 1) out.push('…');
    out.push(n);
    prev = n;
  }
  return out;
}
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {page.url.prev && <a href={page.url.prev}>« Prev</a>}
    {pageNumbers(page.currentPage, totalPages).map((n) =>
      n === '…' ? (
        <span>…</span>
      ) : n === page.currentPage ? (
        <span class="current">{n}</span>
      ) : (
        <a href={n === 1 ? page.url.first ?? page.url.current.replace(/\/\d+\/$/, '/') : `${(page.url.first ?? page.url.current.replace(/\/\d+\/$/, '/')).replace(/\/$/, '')}/${n}/`}>{n}</a>
      )
    )}
    {page.url.next && <a href={page.url.next}>Next »</a>}
  </nav>
)}
